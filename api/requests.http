### ==============================================================================
### Healthcheck Probe
### ==============================================================================

# @name HealthCheck
GET {{baseUrl}}/healthz
Accept: application/json

###
# Expected:
# HTTP 200
# response.body.status == "ok"

### ==============================================================================
### Create Hotel
### ==============================================================================

# @name CreateHotel
POST {{baseUrl}}/api/v1/hotels
Content-Type: {{contentType}}
Accept: application/json

{
  "name": "Grand Budapest Hotel",
  "address": "100 Alpine Way",
  "city": "Lutz"
}

###
# Expected:
# HTTP 201 Created
# response.body.name == "Grand Budapest Hotel"
# response.body.id is a generated UUIDv7

### Capture created hotel and room IDs
@createdHotelId = {{CreateHotel.response.body.id}}
@createdRoomId = {{CreateHotel.response.body.rooms[0].id}}
### ==============================================================================
### Find Hotels
### ==============================================================================

# @name FindHotels
GET {{baseUrl}}/api/v1/hotels?name=Grand
Accept: application/json

###
# Expected:
# HTTP 200
# response.body.hotels is an array of matching hotels

###
# @name FindHotelsEmptyQuery
GET {{baseUrl}}/api/v1/hotels?name=
Accept: application/problem+json

###
# Expected:
# HTTP 400 Bad Request
# response.body.type == "https://err.hotel-booking.io/bad-request"

### ==============================================================================
### Reset Database
### ==============================================================================

# @name ResetDatabase
POST {{baseUrl}}/api/v1/reset
Accept: application/json

###
# Expected:
# HTTP 200 OK
# response.body.message == "Database reset successfully"

### ==============================================================================
### Seed Database
### ==============================================================================

# @name SeedDatabase
POST {{baseUrl}}/api/v1/seed
Accept: application/json

###
# Expected:
# HTTP 200 OK
# response.body.message == "Database seeded successfully"
# response.body.hotels_count == 2
# response.body.rooms_count == 12

### ==============================================================================
### Find Available Rooms
### ==============================================================================

# @name FindAvailableRooms
GET {{baseUrl}}/api/v1/rooms/available?check_in_date=2026-11-01&check_out_date=2026-11-05&guests=2
Accept: application/json

###
# Expected:
# HTTP 200 OK
# response.body.rooms is an array of rooms with capacity >= 2 (double and deluxe only)

###
# @name FindAvailableRoomsByHotel
GET {{baseUrl}}/api/v1/rooms/available?check_in_date=2026-11-01&check_out_date=2026-11-05&guests=1&hotel_id={{createdHotelId}}
Accept: application/json

###
# Expected:
# HTTP 200 OK
# response.body.rooms contains available rooms for that specific hotel

###
# @name FindAvailableRoomsInvalidDates
GET {{baseUrl}}/api/v1/rooms/available?check_in_date=2026-11-05&check_out_date=2026-11-01&guests=1
Accept: application/problem+json

###
# Expected:
# HTTP 400 Bad Request
# response.body.code == "INVALID_QUERY_PARAMETER"

### ==============================================================================
### Book a Room
### ==============================================================================

# @name BookRoom
POST {{baseUrl}}/api/v1/bookings
Content-Type: {{contentType}}
Accept: application/json

{
  "room_id": "{{createdRoomId}}",
  "check_in_date": "2026-11-01",
  "check_out_date": "2026-11-03",
  "number_of_guests": 2,
  "guest_name": "Alice Wonderland",
  "guest_email": "alice@example.com"
}

###
# Expected:
# HTTP 201 Created
# response.body.reference starts with "BK-"

### Capture booking reference
@bookingReference = {{BookRoom.response.body.reference}}

###
# @name BookRoomDoubleBookingConflict
POST {{baseUrl}}/api/v1/bookings
Content-Type: {{contentType}}
Accept: application/problem+json

{
  "room_id": "{{createdRoomId}}",
  "check_in_date": "2026-11-02",
  "check_out_date": "2026-11-04",
  "number_of_guests": 2,
  "guest_name": "Bob Overlap",
  "guest_email": "bob@example.com"
}

###
# Expected:
# HTTP 409 Conflict
# response.body.code == "ROOM_ALREADY_BOOKED"

###
# @name BookRoomCapacityExceeded
POST {{baseUrl}}/api/v1/bookings
Content-Type: {{contentType}}
Accept: application/problem+json

{
  "room_id": "{{createdRoomId}}",
  "check_in_date": "2026-11-01",
  "check_out_date": "2026-11-03",
  "number_of_guests": 10,
  "guest_name": "Too Many People",
  "guest_email": "crowd@example.com"
}

###
# Expected:
# HTTP 400 Bad Request
# response.body.code == "INVALID_BOOKING_REQUEST"

### ==============================================================================
### Find Booking Details
### ==============================================================================

# @name FindBookingDetails
GET {{baseUrl}}/api/v1/bookings/{{bookingReference}}
Accept: application/json

###
# Expected:
# HTTP 200 OK
# response.body.reference == bookingReference
# response.body.hotel.name is present
# response.body.room.room_number is present

###
# @name FindBookingDetailsNotFound
GET {{baseUrl}}/api/v1/bookings/NON-EXISTENT-BOOKING
Accept: application/problem+json

###
# Expected:
# HTTP 404 Not Found
# response.body.code == "BOOKING_NOT_FOUND"
